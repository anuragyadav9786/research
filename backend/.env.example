# Copy to .env and adjust for your local setup. Never commit the real .env.

# Postgres connection string used by both the FastAPI app and Alembic migrations.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/thinkfin

APP_NAME=ThinkFin Research Engine
ENVIRONMENT=development

# Comma-separated list is not supported by pydantic-settings' default list parsing
# for env vars; if overriding, provide a JSON array, e.g. '["http://localhost:3000"]'
CORS_ORIGINS=["http://localhost:3000"]

# Bumped whenever calculation methodology changes (see docs/analytics-methodology.md).
ANALYTICS_VERSION=v0.1.0

# Risk-free rate used by the Sharpe ratio (annualized, decimal form, e.g. 0.07 = 7%).
# Documented assumption — see analytics/risk.py. Update from RBI 91-day T-bill data
# once a real ingestion source is wired up (Phase 3+ open decision).
RISK_FREE_RATE=0.07

# AI Explanation Layer (Phase 12) — optional. Without this set, GET
# /api/funds/{id}/ai-summary returns available:false with a clear reason
# rather than failing; every other endpoint works fine without it. The AI
# never computes a number — see docs/api.md and
# app/services/ai_explanation_service.py.
ANTHROPIC_API_KEY=
AI_EXPLANATION_MODEL=claude-sonnet-5
