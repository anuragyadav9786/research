# Copy to .env and adjust for your local setup. Never commit the real .env.

# Postgres connection string used by both the FastAPI app and Alembic migrations.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/thinkfin

APP_NAME=ThinkFin Research Engine
ENVIRONMENT=development

# Either a JSON array ('["http://localhost:3000","https://example.com"]') or a
# plain comma-separated list (http://localhost:3000,https://example.com) works.
CORS_ORIGINS=["http://localhost:3000"]

# Bumped whenever calculation methodology changes (see docs/analytics-methodology.md).
ANALYTICS_VERSION=v0.1.0

# Risk-free rate used by the Sharpe ratio (annualized, decimal form, e.g. 0.07 = 7%).
# Documented assumption — see analytics/risk.py. Update from RBI 91-day T-bill data
# once a real ingestion source is wired up (Phase 3+ open decision).
RISK_FREE_RATE=0.07

# AI Explanation Layer (Phase 12) — optional. Without this set, GET
# /api/funds/{id}/ai-summary returns available:false with a clear reason
# rather than failing; every other endpoint works fine without it. The AI
# never computes a number — see docs/api.md and
# app/services/ai_explanation_service.py.
ANTHROPIC_API_KEY=
AI_EXPLANATION_MODEL=claude-sonnet-5

# Benchmark Data Engine (Phase 17) — enabled. The NSE provider
# (nseindia.com) needs no API key. Its response shape is confirmed against
# a real captured sample, but the request side (session cookies, headers,
# query params) has not yet been confirmed against a live round trip from
# any environment with real outbound network access — a failed or
# malformed fetch fails closed (falls back to cache or "Data unavailable"),
# never fabricates a value, so this is safe to leave on while that
# confirmation is pending. See docs/data-sources.md section 4. Set to
# false to turn the provider off entirely (e.g. if nseindia.com's terms
# turn out not to permit this kind of automated fetch).
BENCHMARK_NSE_PROVIDER_ENABLED=true
